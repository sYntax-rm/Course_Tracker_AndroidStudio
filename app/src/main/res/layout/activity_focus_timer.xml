<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Timer"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay locked in."
            android:textColor="#8A8FA8"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"/>

        <!-- Session Mode Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:layout_marginBottom="40dp">

            <Button
                android:id="@+id/btnModeStudy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Study"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnModeBreak"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Break"
                android:textSize="13sp"
                android:textColor="#8A8FA8"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnModeLong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Long Break"
                android:textSize="13sp"
                android:textColor="#8A8FA8"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Circular Timer Display -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="40dp">

            <!-- Outer ring background -->
            <View
                android:layout_width="260dp"
                android:layout_height="260dp"/>

            <!-- Progress ring (custom view) -->
            <com.example.dcfg_studyfi_casestuy.TimerProgressView
                android:id="@+id/timerProgressView"
                android:layout_width="260dp"
                android:layout_height="260dp" />

            <!-- Inner circle -->
            <View
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"/>


            <!-- Time text -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25:00"
                    android:textColor="#FFFFFF"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvTimerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDY SESSION"
                    android:textColor="#6C8EFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <!-- Reset -->
            <ImageButton
                android:id="@+id/btnReset"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@android:color/transparent"
                android:contentDescription="Reset"
                android:layout_marginEnd="20dp"/>

            <!-- Start/Pause -->
            <Button
                android:id="@+id/btnStartPause"
                android:layout_width="120dp"
                android:layout_height="56dp"
                android:text="START"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"/>

            <!-- Skip -->
            <ImageButton
                android:id="@+id/btnSkip"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_media_next"
                android:background="@android:color/transparent"
                android:contentDescription="Skip"
                android:layout_marginStart="20dp"/>
        </LinearLayout>

        <!-- Session Stats Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Progress"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Sessions done -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvSessionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#6C8EFF"
                        android:textSize="32sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sessions"
                        android:textColor="#8A8FA8"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#2A2D3E"/>

                <!-- Minutes focused -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvMinutesFocused"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#4ECDC4"
                        android:textSize="32sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minutes"
                        android:textColor="#8A8FA8"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#2A2D3E"/>

                <!-- Goal -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvGoalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="#FF6B6B"
                        android:textSize="32sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal"
                        android:textColor="#8A8FA8"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Progress bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2D3E"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="8dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <View
                    android:id="@+id/progressBarFill"
                    android:layout_width="0dp"
                    android:layout_height="8dp"/>

            </FrameLayout>

        </LinearLayout>

        <!-- Custom Duration Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:layout_marginBottom="32dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Custom Duration"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Study (min):"
                    android:textColor="#8A8FA8"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etStudyDuration"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:hint="25"
                    android:inputType="number"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#444860"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="Break (min):"
                    android:textColor="#8A8FA8"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etBreakDuration"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:hint="5"
                    android:inputType="number"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#444860"
                    android:textSize="14sp" />

            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnApplyDuration"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:text="Apply"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

    </LinearLayout>
</ScrollView>
