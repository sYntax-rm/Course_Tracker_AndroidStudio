<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Track number / playing indicator -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tvTrackNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#8A8FA8"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvPlayingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="▶"
            android:textColor="#6C8EFF"
            android:textSize="14sp"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Track info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvTrackArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A8FA8"
                android:textSize="12sp"/>

            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:background="#8A8FA8"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvTrackCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4ECDC4"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Duration -->
    <TextView
        android:id="@+id/tvTrackDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8A8FA8"
        android:textSize="12sp"
        android:layout_marginStart="8dp"/>

</LinearLayout>

